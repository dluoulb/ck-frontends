
FROM node:20-alpine AS builder

ARG FONTAWESOME_NPM_AUTH_TOKEN=
ENV FONTAWESOME_NPM_AUTH_TOKEN=$FONTAWESOME_NPM_AUTH_TOKEN

ARG DEPLOY_TARGET=
ENV DEPLOY_TARGET=${DEPLOY_TARGET}

ARG NODE_ENV
ENV NODE_ENV=${NODE_ENV}

ARG NEXT_PUBLIC_ENV
ENV NEXT_PUBLIC_ENV=${DEPLOY_TARGET}

ARG NEXT_PUBLIC_BASE_URL
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_ACCEPT_BLUE_TOKEN
ENV NEXT_PUBLIC_ACCEPT_BLUE_TOKEN=$NEXT_PUBLIC_ACCEPT_BLUE_TOKEN

ARG NEXT_PUBLIC_ACCEPT_BLUE_SOURCE
ENV NEXT_PUBLIC_ACCEPT_BLUE_SOURCE=$NEXT_PUBLIC_ACCEPT_BLUE_SOURCE

ARG NEXT_PUBLIC_SUPERTOKENS_API_BASEPATH
ENV NEXT_PUBLIC_SUPERTOKENS_API_BASEPATH=$NEXT_PUBLIC_SUPERTOKENS_API_BASEPATH

ARG NEXT_PUBLIC_SUPERTOKENS_WEBSITE_BASEPATH
ENV NEXT_PUBLIC_SUPERTOKENS_WEBSITE_BASEPATH=$NEXT_PUBLIC_SUPERTOKENS_WEBSITE_BASEPATH

ARG NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN
ENV NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN=$NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN

ARG NEXT_PUBLIC_SUPERTOKENS_WEBSITE_DOMAIN
ENV NEXT_PUBLIC_SUPERTOKENS_WEBSITE_DOMAIN=$NEXT_PUBLIC_SUPERTOKENS_WEBSITE_DOMAIN

ARG NEXT_PUBLIC_SUPERTOKENS_COOKIE_DOMAIN
ENV NEXT_PUBLIC_SUPERTOKENS_COOKIE_DOMAIN=$NEXT_PUBLIC_SUPERTOKENS_COOKIE_DOMAIN

ARG NEXT_PUBLIC_VIRTUAL_CARD_MERCHANT_ID
ENV NEXT_PUBLIC_VIRTUAL_CARD_MERCHANT_ID=$NEXT_PUBLIC_VIRTUAL_CARD_MERCHANT_ID

ARG NEXT_PUBLIC_VC_MERCHANT_KEY
ENV NEXT_PUBLIC_VC_MERCHANT_KEY=$NEXT_PUBLIC_VC_MERCHANT_KEY

ARG NEXT_PUBLIC_VC_MERCHANT_SECRET
ENV NEXT_PUBLIC_VC_MERCHANT_SECRET=$NEXT_PUBLIC_VC_MERCHANT_SECRET

ARG NEXT_PUBLIC_CMS_BASE_URL
ENV NEXT_PUBLIC_CMS_BASE_URL=$NEXT_PUBLIC_CMS_BASE_URL

WORKDIR /app

COPY .npmrc package.json package-lock.json tsconfig.json postcss.config.js next.config.js tailwind.config.js global.css middleware.ts next-env.d.ts ./
RUN npm install

COPY ./shared ./shared
COPY ./types ./types
COPY ./apps ./apps
COPY ./pages ./pages
COPY ./public ./public

RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/out /usr/share/nginx/html
CMD ["nginx", "-g", "daemon off;"]
