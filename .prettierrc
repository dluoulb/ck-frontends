{
    "singleQuote": true,
    "trailingComma": "es5",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^react$",
      "^react",
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "",
      "^~(.*)$",
      "",
      "^\\./",
      "^\\.\\./",
      "^[./]",
      ""
    ]
  }