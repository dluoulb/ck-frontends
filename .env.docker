# This gets set via the `make build` task for staging/prod builds
NEXT_PUBLIC_GIT_SHA=abababa

NODE_ENV=development
NEXT_PUBLIC_ENV='development'

NEXT_PUBLIC_BASE_URL=http://${VHOST_CK_FRONTENDS}
NEXT_PUBLIC_API_URL=http://${VHOST_CK_WEB}

NEXT_PUBLIC_TYPESENSE_API_KEY="typesense-api-key"
NEXT_PUBLIC_TYPESENSE_SERVER=${VHOST_TYPESENSE}
NEXT_PUBLIC_TYPESENSE_PROTOCOL="http"
NEXT_PUBLIC_TYPESENSE_PORT=8108

# SuperTokens
NEXT_PUBLIC_SUPERTOKENS_API_BASEPATH=/
NEXT_PUBLIC_SUPERTOKENS_WEBSITE_BASEPATH=/
NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN=http://${VHOST_AUTH_BACKEND}
NEXT_PUBLIC_SUPERTOKENS_WEBSITE_DOMAIN=http://${VHOST_AUTH_FRONTEND}
NEXT_PUBLIC_SUPERTOKENS_COOKIE_DOMAIN=.${VHOST_SUFFIX}
