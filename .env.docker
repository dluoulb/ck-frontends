NEXT_PUBLIC_ENV='development'
NEXT_PUBLIC_API_URL='http://ck-web.creditkey.localhost'
API_URL='http://ck-web.creditkey.localhost'

NEXT_PUBLIC_BASE_URL=http://frontends.creditkey.localhost

